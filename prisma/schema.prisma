// ============================================================================
// Regulatory Update Wiki — Database Schema
// ============================================================================
// Stack: PostgreSQL + Prisma (matches the existing Case Console project, so
// the Prisma 7 driver-adapter pattern and other quirks already solved there
// carry over directly).
//
// This schema encodes every structural decision made during the IFSCA
// project: Source Document vs Update Entry, single-tag Subject with a
// parent-hierarchy and human-gated new-tag proposals, Digest Summary
// splitting, the amends/supersedes relationship graph, and the
// needs_review / needs_split distinction (a flagged document and a
// structurally-unsplittable digest are NOT the same kind of problem, and
// the schema keeps them as separate fields rather than one generic
// "flagged" boolean, exactly per the reasoning worked out during the
// IFSCA build).
//
// NOT yet finalized — read the comments marked "OPEN QUESTION" below and
// resolve them before treating this as final.
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// DOMAIN / REGULATOR
// ----------------------------------------------------------------------------
// Domain groups regulators that share a taxonomy family (e.g. "Financial
// Services" covers IFSCA, SEBI, RBI). Subject and Applicability vocabularies
// are defined per Regulator (not shared across Domain automatically), since
// even regulators in the same Domain can diverge — but Instrument Type and
// Status vocabularies CAN be shared at the Domain level if they turn out to
// be identical across a Domain's regulators (decide this per Domain as it's
// built, don't assume uniformity up front).

model Domain {
  id          String       @id @default(cuid())
  name        String       @unique // e.g. "Financial Services", "Telecom"
  description String?
  regulators  Regulator[]
  createdAt   DateTime     @default(now())
}

model Regulator {
  id              String           @id @default(cuid())
  code            String           @unique // e.g. "IFSCA", "SEBI" — used in document codes
  name            String           // full name
  domainId        String
  domain          Domain           @relation(fields: [domainId], references: [id])
  websiteUrl      String?
  sourceDocuments   SourceDocument[]
  taxonomyTags      TaxonomyTag[]
  taxonomyProposals TaxonomyProposal[]
  createdAt         DateTime           @default(now())

  @@index([domainId])
}

// ----------------------------------------------------------------------------
// CONTROLLED TAXONOMY
// ----------------------------------------------------------------------------
// One table for every facet's controlled vocabulary (Subject, Instrument
// Type, Applicability), distinguished by `facet`. Keeping them in one table
// (rather than a separate table per facet) makes the human-gated new-tag
// proposal workflow uniform across facets instead of needing bespoke
// approval logic per facet.
//
// Subject tags support a parent/child hierarchy via `parentId`, matching
// the IFSCA taxonomy's Insurance > IIO / IIIO style structure. Instrument
// Type and Applicability are currently flat (no parent) — revisit if a
// future domain needs hierarchy there too.

enum Facet {
  SUBJECT
  INSTRUMENT_TYPE
  APPLICABILITY
  LICENSE_AUTHORISATION_TYPE // multi-tag, DoT-specific so far -- which legacy
                              // license(s)/new-regime authorisation(s) a
                              // document concerns. Modeled like APPLICABILITY
                              // (its own join table, EntryLicenseAuthorisationType)
                              // rather than like SUBJECT/INSTRUMENT_TYPE, which
                              // are both single-tag despite INSTRUMENT_TYPE
                              // having looked multi-tag at a glance -- confirmed
                              // by reading the schema directly, not assumed.
  STATUS // single-tag, per-regulator, replacing the old fixed global
         // DocumentStatus enum -- added for DST (2026-08-17), which is the
         // first regulator needing a genuinely different Status vocabulary
         // (its Funding Calls Subjects use Open/Closed/Results Announced
         // instead of In Force/Draft/Amended/Superseded). This is exactly
         // the scenario the schema's own former "Open Question #4" flagged
         // as a future possibility. Every other regulator gets the same 4
         // values as before, just now stored as data instead of a fixed
         // enum -- see TaxonomyTag.statusAppliesToSubjectIds below for how
         // a Status tag can be scoped to only some Subjects.
}

enum TagStatus {
  ACTIVE
  UNDER_REVIEW // proposed by the detection pipeline, awaiting human approval
  DEPRECATED   // no longer used for new tagging, kept for historical entries
}

model TaxonomyTag {
  id            String        @id @default(cuid())
  regulatorId   String
  regulator     Regulator     @relation(fields: [regulatorId], references: [id])
  facet         Facet
  name          String        // display name, e.g. "Capital Markets > Capital Market Intermediaries"
  shortCode     String        // for document codes, e.g. "CMI"
  definition    String?       // one-line definition, shown in the admin UI and tagging guide
  parentId      String?
  parent        TaxonomyTag?  @relation("TagHierarchy", fields: [parentId], references: [id])
  children      TaxonomyTag[] @relation("TagHierarchy")
  status        TagStatus     @default(ACTIVE)
  versionAdded  String?       // e.g. "v1.4" — for audit trail, matches the IFSCA taxonomy's versioning
  notes         String?       // rationale for non-obvious decisions (e.g. "Pension routes here per
                               // explicit decision, not Fund Management — do not silently remap")
  // STATUS-facet only: which SUBJECT-facet TaxonomyTag ids (same regulator)
  // this Status value is valid for. Empty array (the default, and the only
  // value every non-DST regulator uses) means "applies to every Subject" --
  // matching the old global enum's uniform behavior exactly. Non-empty means
  // this Status tag is a category error outside those specific Subjects
  // (e.g. DST's "Open / Accepting Applications" only makes sense for its
  // three Funding Calls Subjects) -- both the classification prompt and the
  // ingestion pipeline's own validation read this, see lib/ingest.ts.
  statusAppliesToSubjectIds String[] @default([])
  createdAt     DateTime      @default(now())

  subjectOnEntries       UpdateEntry[]        @relation("EntrySubject")
  instrumentOnEntries    UpdateEntry[]        @relation("EntryInstrument")
  statusOnEntries        UpdateEntry[]        @relation("EntryStatus")
  applicabilityOnEntries EntryApplicability[]
  licenseAuthorisationTypeOnEntries EntryLicenseAuthorisationType[]

  @@unique([regulatorId, facet, name])
  @@index([regulatorId, facet])
}

// Proposed new tags surfaced by the detection pipeline (clustering
// unresolved documents), awaiting human approval — see PIPELINE_OVERVIEW /
// STRATEGIC_PLAN §5.6 for the reasoning: detection is automated, the
// decision to actually add a tag is not.

model TaxonomyProposal {
  id                String    @id @default(cuid())
  regulatorId       String
  regulator         Regulator @relation(fields: [regulatorId], references: [id])
  facet             Facet
  proposedName      String
  rationale         String    // why the clustering pipeline thinks this deserves a new tag
  exampleEntryIds   String[]  // Update Entry IDs used as supporting examples
  status            String    @default("pending") // pending | approved | rejected | merged_into_existing
  resolvedTagId     String?   // set once approved (points at the resulting TaxonomyTag) or merged
  reviewedBy        String?
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())

  @@index([regulatorId, status])
}

// ----------------------------------------------------------------------------
// SOURCE DOCUMENT / UPDATE ENTRY
// ----------------------------------------------------------------------------
// SourceDocument = the actual file. UpdateEntry = the tagged record. Most
// SourceDocuments have exactly one UpdateEntry; a Digest (e.g. a Bulletin)
// has many, each with sourceNature = DIGEST_SUMMARY and a pointer back to
// the SourceDocument via sourceDocumentId (already the case structurally —
// no separate "parent" field needed since digest items ARE UpdateEntries
// of that SourceDocument, same as a normal single-entry document).

enum SourceNature {
  PRIMARY
  DIGEST_SUMMARY
}

model SourceDocument {
  id            String        @id @default(cuid())
  regulatorId   String
  regulator     Regulator     @relation(fields: [regulatorId], references: [id])
  sourceId      String        // the ORIGINAL scraper's own dedup id/hash (NormalizedDocument.source_id)
                               // — kept as a stable fingerprint distinct from our own generated
                               // documentCode, so the ingestion pipeline can dedup against a
                               // scraper re-run without depending on sourceUrl matching exactly
  title         String
  sourceUrl     String        // the page/listing this was discovered on
  fileUrl       String?       // direct link to the PDF/file, if different from sourceUrl
  s3Key         String?       // where the raw file lives in object storage
  publishedDate DateTime?
  discoveredAt  DateTime      @default(now())
  // Set ONCE by the ingestion pipeline when the row is first written, and
  // never updated afterwards. This is what makes "new since yesterday"
  // answerable for a future digest.
  //
  // NOTE on the overlap with discoveredAt, which already existed: they will
  // usually hold the same instant. The difference is who sets them.
  // discoveredAt is a database DEFAULT, so it fires on ANY insert including a
  // manual backfill or a restore, whereas firstIngestedAt is written
  // explicitly by ingest.ts and therefore means specifically "entered the
  // corpus through the real ingestion pipeline". Digest queries should read
  // this field. Nullable so the 1,767 pre-existing rows could be backfilled
  // from discoveredAt rather than left as a misleading NULL.
  firstIngestedAt DateTime?
  rawTextS3Key  String?       // extracted full text, stored separately from the DB row (can be large)
  isDigest      Boolean       @default(false) // true for Bulletin-equivalent documents
  updateEntries UpdateEntry[]

  @@index([regulatorId])
  @@index([firstIngestedAt])
  @@unique([regulatorId, sourceId])
}

model UpdateEntry {
  id                 String         @id @default(cuid())
  documentCode       String         @unique // e.g. "IFSCA-CMI-CIR-2024-003"
  sourceDocumentId   String
  sourceDocument     SourceDocument @relation(fields: [sourceDocumentId], references: [id])
  sourceNature       SourceNature   @default(PRIMARY)

  title              String         // may differ from SourceDocument.title for split digest items
  summary            String?        // short excerpt/digest, if generated

  subjectId          String?
  subject            TaxonomyTag?   @relation("EntrySubject", fields: [subjectId], references: [id])
  instrumentTypeId   String?
  instrumentType     TaxonomyTag?   @relation("EntryInstrument", fields: [instrumentTypeId], references: [id])
  statusId           String?
  statusTag          TaxonomyTag?   @relation("EntryStatus", fields: [statusId], references: [id])

  applicability      EntryApplicability[]
  licenseAuthorisationType EntryLicenseAuthorisationType[]
  relationshipsFrom  EntryRelationship[] @relation("RelationshipFrom")
  relationshipsTo    EntryRelationship[] @relation("RelationshipTo")

  subjectConfidence      Float?
  instrumentConfidence   Float?
  statusConfidence       Float?
  classificationReason   String?   // the model's one-line justification — kept for auditability

  needsReview        Boolean        @default(false) // genuinely uncertain classification
  needsSplit         Boolean        @default(false) // structural digest, not yet split
  reviewReasons      String[]

  taxonomyVersion    String?        // which taxonomy version this was tagged against
  classifiedBy        String?       // model/version used, e.g. "deepseek-chat-2026-XX" — for audit trail
                                     // when models or prompts change

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([subjectId])
  @@index([instrumentTypeId])
  @@index([statusId])
  @@index([needsReview])
  @@index([needsSplit])
  @@index([sourceDocumentId])
}

// Applicability is multi-tag, so it needs its own join table rather than a
// simple foreign key.

model EntryApplicability {
  id            String      @id @default(cuid())
  updateEntryId String
  updateEntry   UpdateEntry @relation(fields: [updateEntryId], references: [id])
  tagId         String
  tag           TaxonomyTag @relation(fields: [tagId], references: [id])

  @@unique([updateEntryId, tagId])
}

// License/Authorisation Type is multi-tag, same reasoning as Applicability --
// its own dedicated join table, NOT a reuse of EntryApplicability, so a query
// for an entry's Applicability tags can never accidentally pick up its
// License/Authorisation Type tags (or vice versa) just because both facets
// happen to live in the same TaxonomyTag table.

model EntryLicenseAuthorisationType {
  id            String      @id @default(cuid())
  updateEntryId String
  updateEntry   UpdateEntry @relation(fields: [updateEntryId], references: [id])
  tagId         String
  tag           TaxonomyTag @relation(fields: [tagId], references: [id])

  @@unique([updateEntryId, tagId])
}

// Relationship graph: amends / amended_by / supersedes / superseded_by /
// extends_timeline. Modeled as directed edges between UpdateEntries.
// `targetHint` holds the raw extracted text before it's resolved to an
// actual UpdateEntry id (matches core_engine.py's extract_relationships,
// which produces unresolved hints that need a second pass to match).

enum RelationshipType {
  AMENDS
  SUPERSEDES
  EXTENDS_TIMELINE
}

model EntryRelationship {
  id           String            @id @default(cuid())
  fromEntryId  String
  fromEntry    UpdateEntry       @relation("RelationshipFrom", fields: [fromEntryId], references: [id])
  toEntryId    String?           // null until resolved
  toEntry      UpdateEntry?      @relation("RelationshipTo", fields: [toEntryId], references: [id])
  type         RelationshipType
  targetHint   String            // raw text describing the target, e.g. "IFSCA (CMI) Regulations, 2021"
  resolved     Boolean           @default(false)
  createdAt    DateTime          @default(now())

  @@index([fromEntryId])
  @@index([toEntryId])
}

// ----------------------------------------------------------------------------
// ADMIN / USERS
// ----------------------------------------------------------------------------
// Matches the Case Console pattern (NextAuth). Two roles minimum: ADMIN
// (taxonomy approval, manual re-tagging, sees the review queue) and VIEWER
// (browses the public wiki). Extend if the real deployment needs more
// granularity (e.g. per-domain admin permissions once multiple domains
// are live).

enum Role {
  ADMIN
  VIEWER
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  role          Role      @default(VIEWER)
  createdAt     DateTime  @default(now())
  // NextAuth v4's Credentials provider (chosen for /admin/review's gate --
  // see lib/auth.ts) cannot persist through an Adapter at all: NextAuth
  // itself only calls an Adapter for OAuth/Email sign-ins, never for
  // Credentials, so the standard Account/Session/VerificationToken tables
  // this model's old comment anticipated are not needed here -- sessions are
  // JWT-based instead (see lib/auth.ts's `session.strategy`). passwordHash is
  // the one field Credentials auth actually needs; set via
  // scripts/set-admin-password.ts, never through a public signup form (none
  // exists -- admins are provisioned out-of-band, by design, for an
  // internal-only tool).
  passwordHash  String
}

// ============================================================================
// OPEN QUESTIONS — resolve before treating this schema as final
// ============================================================================
// 1. RESOLVED (2026-07-28): Instrument Type stays scoped per-Regulator, not
//    shared at the Domain level. Real evidence from the SEBI and PFRDA
//    scraper configs shows Instrument Type vocabularies overlap but are NOT
//    identical even within the same Financial Services domain — e.g. PFRDA
//    has "Enforcement Order," which neither SEBI nor IFSCA do. A shared
//    Domain-level list would either lose that regulator-specific nuance or
//    get bloated with entries that only apply to a couple of regulators.
//    This confirms the original per-Regulator design was correct. Do not
//    silently revisit this without new evidence of actual cross-regulator
//    duplication (not just superficial name overlap).
//    Status is a separate matter and was never part of this question: it's
//    already a global DocumentStatus enum, not a per-Regulator TaxonomyTag
//    facet — see open question #4 below for the (separately deferred)
//    status question.
// 2. SourceDocument.rawTextS3Key vs storing extracted text directly in
//    Postgres: decided here to keep it in S3 (full text can be large,
//    and Postgres isn't the ideal store for large blobs) — confirm this
//    matches actual usage patterns once the admin UI needs to display
//    full text for review.
// 3. No explicit "Time" table — Year/Quarter are meant to be derived from
//    SourceDocument.publishedDate at query time, not stored redundantly.
//    Confirm the frontend's faceted-filter queries can do this
//    efficiently at scale, or add a generated/indexed column if not.
// 4. RESOLVED (2026-08-17): DST needed a genuinely different status
//    vocabulary (Funding Calls use Open/Closed/Results Announced, not
//    In Force/Draft/Amended/Superseded), so DocumentStatus became a
//    TaxonomyTag-style STATUS facet, exactly as anticipated here. Every
//    pre-existing regulator was backfilled onto the same 4 values as
//    before, now stored as per-regulator data instead of a fixed enum --
//    see TaxonomyTag.statusAppliesToSubjectIds for how a Status value can
//    be scoped to only some Subjects (DST is the only regulator that uses
//    this; every other regulator's Status tags apply to all Subjects).
// ----------------------------------------------------------------------------
// SYNC RUN LOG
// ----------------------------------------------------------------------------
// Every scheduled (or manual) sync writes one SyncRun plus one
// SyncRunRegulator per regulator attempted. This is the inspectable record a
// future daily digest reads from -- deliberately a table rather than a log
// file, because the digest needs to query "what was new since the last run"
// and a file would mean parsing text.
//
// A regulator being BLOCKED is a first-class recorded outcome, not an error:
// dot.gov.in and meity.gov.in have both genuinely served 403s during this
// project, and a run where one regulator was blocked must be distinguishable
// from a run where that regulator genuinely had nothing new.

enum SyncStatus {
  OK
  BLOCKED   // the site refused us (403/WAF). NOT the same as "no new documents".
  ERROR     // scraper or ingestion failed for some other reason
  SKIPPED   // deliberately not attempted on this run
}

model SyncRun {
  id          String              @id @default(cuid())
  startedAt   DateTime            @default(now())
  finishedAt  DateTime?
  trigger     String              @default("manual") // manual | schedule
  regulators  SyncRunRegulator[]

  @@index([startedAt])
}

model SyncRunRegulator {
  id             String     @id @default(cuid())
  syncRunId      String
  syncRun        SyncRun    @relation(fields: [syncRunId], references: [id], onDelete: Cascade)
  regulatorCode  String
  status         SyncStatus

  scrapedRows    Int        @default(0)  // rows the scraper produced in total
  newDocuments   Int        @default(0)  // genuinely new after sourceId dedup
  ingested       Int        @default(0)  // written cleanly
  flagged        Int        @default(0)  // written but needsReview=true
  errors         Int        @default(0)

  detail         String?                 // blocked reason / error text / notes
  durationMs     Int        @default(0)
  createdAt      DateTime   @default(now())

  @@index([syncRunId])
  @@index([regulatorCode, createdAt])
}
