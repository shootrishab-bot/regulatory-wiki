# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the committed template of which vars are needed (no real values)
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# scrapers/ (Python side — see scrapers/requirements.txt)
scrapers/.venv
scrapers/__pycache__/
scrapers/**/__pycache__/
*.pyc
# per-script scraped-output directories (regenerated by running the
# scrapers; not source, not meant to be committed — see each script's own
# DATA_DIR/OUT_DIR for the exact name it uses)
scrapers/data/
scrapers/dot/
scrapers/pfrda/
scrapers/aptel/
scrapers/cerc/
# run logs from ad-hoc/debugging scraper invocations — not source, and
# every future run would otherwise add more of them
scrapers/*.log

# tesseract.js language data, downloaded on demand at runtime by
# scripts/backfill-missing-dates.ts -- a ~5MB binary artifact, not source
eng.traineddata
*.traineddata
# meity scraper output dir (same reasoning as the other scraped-output dirs above)
scrapers/meity_documents/
# DST's cached extracted Markdown (scrapers/dst/extract.ts) -- regenerated
# from real source PDFs/pages on demand, not source, and can hold a lot of
# real extracted document text
scrapers/dst/cache/

# fiu_scraper's own SQLite database + downloaded PDFs (mirrors cci_scraper's
# equivalent, which predates this file and isn't ignored yet -- not this
# task's scope to fix) and its test-sample/test-sample-stratified JSON output
scrapers/fiu_scraper/data/
scrapers/fiu_scraper/output/

# cci_scraper's own SQLite database + downloaded PDFs (~1.2 GB of scraped
# source documents) and its test-sample/run-log output -- the equivalent of
# fiu_scraper/data and fiu_scraper/output above, which this file already
# ignores. Regenerated by running the scraper; never source.
scrapers/cci_scraper/data/
scrapers/cci_scraper/output/

# graphify knowledge-graph output -- local analysis tooling artifact, not
# part of the application.
graphify-out/

# scratch files from ad-hoc analysis runs
flagged_analysis_tmp.txt

# ad-hoc one-off diagnostics kept locally, not part of the shipped tooling
scrapers/tmp_*.py
scripts/tmp-*.ts
# raw Claude Code session transcript captured while building the CCI scraper
scrapers/cci_scraper/RegWiki.txt
