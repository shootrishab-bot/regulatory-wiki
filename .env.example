# Copy to `.env` and fill in real values. `.env` is gitignored -- never commit it.
# Loaded by `import "dotenv/config"` (prisma.config.ts and every script entrypoint)
# and by Next.js itself for the app.

# --- Database (required) -------------------------------------------------
# PostgreSQL connection string. Any Postgres works; the dev instance is Neon,
# which needs `?sslmode=require`. Prisma reads this via prisma.config.ts.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# --- Classification LLM (required for ingestion) -------------------------
# DeepSeek API key. lib/ingest.ts calls it (via the `openai` SDK pointed at
# DeepSeek's OpenAI-compatible endpoint) to map each scraped document onto the
# regulator's taxonomy. The web app reads the database only and does not need
# this; `npm run sync` and the scripts/ingest-*.ts scripts do.
DEEPSEEK_API_KEY=""

# --- Admin auth (required to log in to /admin) ---------------------------
# Signs/encrypts the NextAuth JWT session cookie (Credentials provider, see
# lib/auth.ts). Generate a fresh value per environment -- do not reuse across
# deployments:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""

# Public origin of the deployment. http://localhost:3000 for local dev; the
# real https:// URL in a deployed environment.
NEXTAUTH_URL="http://localhost:3000"
