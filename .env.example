# Copy to `.env` and fill in real values. `.env` is gitignored -- never commit it.
# Loaded by `import "dotenv/config"` (prisma.config.ts and every script entrypoint)
# and by Next.js itself for the app.

# --- Database (required) -------------------------------------------------
# PostgreSQL connection string. Any Postgres works; the dev instance is Neon,
# which needs `?sslmode=require`. Prisma reads this via prisma.config.ts.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# --- Classification AI model (required for ingestion) -------------------
# lib/ingest.ts sends each new document to this model to map it onto the
# regulator's taxonomy. Any provider with an OpenAI-compatible
# /chat/completions endpoint that supports JSON-object responses works
# (OpenAI, Azure OpenAI, Google Gemini's OpenAI-compatible endpoint, Mistral,
# DeepSeek, an internal gateway, ...). Set all three. The web app reads the
# database only and does not need these; `npm run sync`, the
# scripts/ingest-*.ts scripts and the CCI/FIU scrapers do.
LLM_API_KEY="<your-provider-api-key>"
LLM_BASE_URL="<your-provider-openai-compatible-base-url>"   # e.g. https://api.openai.com/v1
LLM_MODEL="<your-model-name>"

# Legacy: with the three LLM_* settings unset, DEEPSEEK_API_KEY alone selects
# DeepSeek (https://api.deepseek.com, deepseek-chat), the original setup.
# DEEPSEEK_API_KEY=""

# --- Admin auth (required to log in to /admin) ---------------------------
# Signs/encrypts the NextAuth JWT session cookie (Credentials provider, see
# lib/auth.ts). Generate a fresh value per environment -- do not reuse across
# deployments:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""

# Public origin of the deployment. http://localhost:3000 for local dev; the
# real https:// URL in a deployed environment.
NEXTAUTH_URL="http://localhost:3000"
